.git/
.gitignore
.gitattributes
.github
.github/
.beads
.beads/
.dolt/
graphify-out
graphify-out/
.graphifyignore
.agents
.agents/
_workspace
_workspace/
.vscode/
.vs/
.idea/
.clangd/

# Build trees, caches & intermediate artifacts
build
build/
build*/
cmake-build-*/
out
out/
dist/
bin/
obj/
target/
vcpkg_installed/
node_modules
node_modules/
**/node_modules/
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/

