.env
.env*
*.env
*.secret
*.token
*.pem
*.key
*.pfx
certs/*.key
certs/*.pem
certs/*.crt
config/certs/*.key
config/*.local.json
config/local.json

# Documentation, test fixtures & local scripts excluded from container build context
