# =============================================================================
# 3. STRICT LF TEXT FILES (GO, PROTOCOLS, SHELL, CONTAINERS & DOTFILES)
# =============================================================================
# --- Go (WHY: enforce LF so Windows core.autocrlf never triggers gofmt diffs) ---
*.go                        text eol=lf diff=golang
go.mod                      text eol=lf
go.sum                      text eol=lf
go.work                     text eol=lf
go.work.sum                 text eol=lf

# --- Protobuf, FlatBuffers & Buf ---
*.fbs                       text eol=lf
*.proto                     text eol=lf
buf.gen.yaml                text eol=lf
buf.lock                    text eol=lf
buf.yaml                    text eol=lf

# --- POSIX Shell, Make & Containers ---
*.bash                      text eol=lf
*.dockerfile                text eol=lf
*.sh                        text eol=lf
*.zsh                       text eol=lf
.dockerignore               text eol=lf
Dockerfile                  text eol=lf
Dockerfile.*                text eol=lf
GNUmakefile                 text eol=lf
Justfile                    text eol=lf
Makefile                    text eol=lf

# --- Repository Dotfiles ---
.editorconfig               text eol=lf
.gitattributes              text eol=lf
.gitignore                  text eol=lf
.graphifyignore             text eol=lf

