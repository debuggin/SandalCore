# =============================================================================
# 1. DEFAULT AUTO-DETECTION
# =============================================================================
# --- Repository-wide fallback normalization ---
* text=auto eol=lf

# --- Agent Harness & Customization Bundles ---
.agents/** text eol=lf

# =============================================================================
# 2. POLYGLOT SOURCE CODE & SEMANTIC DIFF DRIVERS
# =============================================================================
# --- C / C++ / Assembly / CMake ---
*.S text eol=lf
*.asm text eol=lf
*.c text eol=lf diff=cpp
*.cc text eol=lf diff=cpp
*.cmake text eol=lf
*.cmake.in text eol=lf
*.cpp text eol=lf diff=cpp
*.cppm text eol=lf diff=cpp
*.cxx text eol=lf diff=cpp
*.h text eol=lf diff=cpp
*.hh text eol=lf diff=cpp
*.hpp text eol=lf diff=cpp
*.hxx text eol=lf diff=cpp
*.idc text eol=lf diff=cpp
