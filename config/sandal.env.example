AOC_TLS_CA_CERT=certs/ca.pem
AOC_ADMIN_HTTP_BIND_ADDR=127.0.0.1:8090
AOC_ADMIN_HTTP_ADVERTISE_ADDR=127.0.0.1:8090
AOC_ADMIN_HTTPS_BIND_ADDR=127.0.0.1:8443
