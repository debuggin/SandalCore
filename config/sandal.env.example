# 1. Core Runtime, Logging & Client Paths (#1-#9)
AOC_ENV=development
SANDAL_CONFIG_FILE=config/sandal.env
SANDAL_ADVERTISE_HOST=127.0.0.1
SANDAL_LOG_LEVEL=INFO
SANDAL_LOG_FORMAT=json
SANDAL_CLIENT_PAK_DIR=C:\Program Files\Intrepid Studios\Ashes of Creation\AOC\Content\Paks
SANDAL_CLIENT_EXE_PATH=AOC\Binaries\Win64\AoCClient-Win64-Shipping.exe
SANDAL_CLIENT_USE_EOS=false
SANDAL_USMAP_PATH=data/mappings/<mappings>.usmap
# 2. Extraction, Backing Storage, Navmesh & Security Tokens (#10-#27)
AOC_SKIP_EXTRACTION=0
AOC_EXTRACTOR_THREADS=0
AOC_EXTRACTED_DIR=dist/extracted
AOC_MESH_MODE=standalone
AOC_DATABASE_URL=postgres://aoc:aoc@127.0.0.1:5433/aoc?sslmode=disable
AOC_POSTGRES_HOST_PORT=5433
AOC_DB_MAX_CONNS=16
AOC_DB_MIN_CONNS=2
AOC_SQL_MIGRATIONS_DIR=sql/migrations
AOC_CONTENT_DB_PATH=dist/content/content.db
AOC_HOTFIX_DIR=data/hotfixes
AOC_PMTILES_PATH=dist/content/verra.pmtiles
AOC_NAVMESH_DIR=dist/nav
AOC_RIVERLANDS_NAVMESH_PATH=dist/nav/riverlands.aocnav
AOC_VMAP_PATH=dist/nav/area_vmap.bin
AOC_SERVICE_TOKEN_FILE=dist/services/service.token
AOC_TOKEN_TTL=24h
AOC_TICKET_TTL=2m
# 3. Edge Gateway, Admin BFF, Tether & MeshGW Bind/Advertise (#28-#46)
AOC_GATEWAY_HTTP_BIND_ADDR=127.0.0.1:8080
