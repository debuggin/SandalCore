<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SandalLauncher.ViewModels"
        xmlns:models="using:SandalLauncher.Models"
        xmlns:services="using:SandalLauncher.Services"
        x:Class="SandalLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        MinWidth="960"
        MinHeight="560"
        Width="1067"
        Height="600"
        Title="SandalCore — Ashes of Creation Sanctuary Launcher"
        Background="{DynamicResource SurfacePrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AutomationProperties.Name="SandalCore Ashes of Creation Sanctuary Launcher Window">

  <Grid ColumnDefinitions="5*,5*">

    <!-- LAYER 0: Full-Bleed Custom 16:9 Key Art (launcher_background.jpg) + Soft Left-50% Contrast Vignette -->
    <Border Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="{DynamicResource AoCHeroFallbackBrush}"
            IsHitTestVisible="False">
      <Panel>
        <Image Source="avares://SandalLauncher/Assets/launcher_background.jpg"
               Stretch="UniformToFill" />
        <Border Background="{DynamicResource AoCLeftVignetteBrush}" />
      </Panel>
    </Border>

    <!-- LAYER 1: Left 50% Control Deck (Grid.Column="0") — All Interactive Controls Contained in Left 50% -->
    <Border Grid.Column="0"
            MaxWidth="485"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Margin="22,16,14,16"
            Background="{DynamicResource AoCFiligreeDeckBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="20,16,20,16"
            AutomationProperties.Name="Left 50 Percent Interactive Launcher Control Deck">
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- 1. Brand Header + Live Realm Pill + Inline Settings Toggle -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
          <Grid ColumnDefinitions="*,Auto,6,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="SANDALCORE"
                         FontFamily="Georgia, Times New Roman, serif"
                         FontSize="19"
                         FontWeight="Bold"
                         LetterSpacing="3.0"
                         Foreground="{DynamicResource AoCHeadlineTextBrush}" />
              <TextBlock Text="ASHES OF CREATION — SANCTUARY LAUNCHER"
                         FontSize="9"
                         FontWeight="SemiBold"
                         LetterSpacing="1.6"
                         Foreground="{DynamicResource AccentGoldBrush}" />
            </StackPanel>

            <Border Grid.Column="1"
                    x:Name="RealmStatusPill"
                    Background="{DynamicResource AoCInputFillBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="9,5"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Realm Status Pill">
              <TextBlock Text="{Binding RealmStatusShortText}"
                         Foreground="{DynamicResource StatusOnlineBrush}"
                         FontWeight="Bold"
                         FontSize="10.5" />
            </Border>

            <Button Grid.Column="3"
                    Content="⚙"
                    Command="{Binding ToggleSettingsCommand}"
                    Classes="aoc-filigree-btn"
                    MinWidth="32"
                    MinHeight="30"
                    Padding="7,4"
                    FontSize="12"
                    ToolTip.Tip="Configure Server &amp; Steam Client Path"
                    AutomationProperties.Name="Toggle Inline Server and Client Settings" />
          </Grid>

          <Border Height="1" Background="{DynamicResource AoCGoldDividerBrush}" />
        </StackPanel>

        <!-- 2. Scrollable Middle Stack: Realm Bar, Inline Settings Drawer, Saved Accounts & Auth Card -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="9">

            <!-- 2A. Server / Realm Environment Selector Bar -->
            <Border Background="{DynamicResource AoCInputFillBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="11,8">
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0"
                             Text="SERVER / REALM"
                             FontSize="9.5"
                             FontWeight="Bold"
                             LetterSpacing="1.3"
                             Foreground="{DynamicResource AccentChampagneGoldBrush}"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Content="↻ Refresh"
                          Command="{Binding RetryProbeCommand}"
                          Classes="aoc-filigree-btn"
                          MinHeight="24"
                          Padding="8,2"
                          FontSize="10.5"
                          AutomationProperties.Name="Refresh Server Status" />
                </Grid>

                <ComboBox ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          MinHeight="34"
                          Background="{DynamicResource SurfacePrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          AutomationProperties.Name="Server Realm Selector">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:LauncherProfile" x:CompileBindings="True">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding DisplayName}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding GatewayHttpAddr}"
                                   FontSize="11"
                                   Foreground="{DynamicResource AccentGoldBrush}"
                                   Margin="8,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- 2B. Inline Expandable Settings Drawer (Stays Inside Left 50% Deck) -->
            <Border IsVisible="{Binding IsSettingsOpen}"
                    Background="{DynamicResource AoCSettingsCardBrush}"
                    BorderBrush="{DynamicResource AccentJewelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,10"
                    AutomationProperties.Name="Server and Client Settings Panel">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0"
                             Text="ENDPOINT &amp; STEAM CLIENT SETTINGS"
                             FontSize="10"
                             FontWeight="Bold"
                             LetterSpacing="1.2"
                             Foreground="{DynamicResource AccentChampagneGoldBrush}"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Content="Auto-Detect Steam"
                          Command="{Binding AutoDetectSteamClientCommand}"
                          Classes="aoc-filigree-btn"
                          MinHeight="26"
                          Padding="8,3"
                          FontSize="10.5"
                          AutomationProperties.Name="Auto Detect Steam Client Path" />
                </Grid>

                <Grid ColumnDefinitions="*,8,*">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="GATEWAY HTTP"
                               FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentGoldBrush}" />
                    <TextBox Text="{Binding EditGatewayHttpAddr, Mode=TwoWay}"
                             Watermark="127.0.0.1:8080"
                             Classes="aoc-input"
                             MinHeight="32"
                             FontSize="11.5"
                             AutomationProperties.Name="Gateway HTTP Address Input" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="WORLD ENDPOINT"
                               FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentGoldBrush}" />
                    <TextBox Text="{Binding EditWorldEndpoint, Mode=TwoWay}"
                             Watermark="127.0.0.1:7777"
                             Classes="aoc-input"
                             MinHeight="32"
                             FontSize="11.5"
                             AutomationProperties.Name="World Endpoint Input" />
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="3">
                  <TextBlock Text="ASHES OF CREATION CLIENT / PAK DIRECTORY"
                             FontSize="9.5"
                             FontWeight="Bold"
                             Foreground="{DynamicResource AccentGoldBrush}" />
                  <TextBox Text="{Binding EditClientPakDir, Mode=TwoWay}"
                           Watermark="C:\Program Files (x86)\Steam\steamapps\common\Ashes of Creation Playtest"
                           Classes="aoc-input"
                           MinHeight="32"
                           FontSize="11.5"
                           AutomationProperties.Name="Client Pak Directory Input" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,8,Auto">
                  <TextBlock Grid.Column="0"
                             Text="{Binding ClientStatusSummary}"
                             FontSize="10.5"
                             Foreground="{DynamicResource StatusOnlineBrush}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="1"
                          Content="Close"
                          Command="{Binding ToggleSettingsCommand}"
                          Classes="aoc-filigree-btn"
                          MinHeight="28"
                          Padding="10,4"
                          FontSize="11"
                          AutomationProperties.Name="Close Settings Drawer" />
                  <Button Grid.Column="3"
                          Content="Save"
                          Command="{Binding SaveProfileCommand}"
                          Classes="aoc-jewel-cta"
                          MinHeight="28"
                          Padding="12,4"
                          FontSize="11"
                          AutomationProperties.Name="Save Server Profile Settings" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- 2C. Saved Accounts 1-Click Quick-Switcher (Visible when HasSavedAccounts is true) -->
            <Border IsVisible="{Binding HasSavedAccounts}"
                    Background="{DynamicResource AoCInputFillBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="11,8"
                    AutomationProperties.Name="Saved Accounts Switcher Bar">
              <StackPanel Spacing="5">
                <TextBlock Text="SAVED ACCOUNTS (1-CLICK SWITCH)"
                           FontSize="9.5"
                           FontWeight="Bold"
                           LetterSpacing="1.2"
                           Foreground="{DynamicResource AccentChampagneGoldBrush}" />
                <Grid ColumnDefinitions="*,6,Auto,6,Auto">
                  <ComboBox Grid.Column="0"
                            ItemsSource="{Binding SavedAccounts}"
                            SelectedItem="{Binding SelectedSavedAccount, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            MinHeight="32"
                            Background="{DynamicResource SurfacePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            AutomationProperties.Name="Saved Accounts Dropdown">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="services:SavedAccountRecord" x:CompileBindings="True">
                        <TextBlock Text="{Binding DisplayLabel}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="2"
                          Content="Switch"
                          Command="{Binding SelectSavedAccountCommand}"
                          Classes="aoc-filigree-btn"
                          MinHeight="32"
                          Padding="10,4"
                          FontSize="11"
                          AutomationProperties.Name="Switch to Selected Saved Account" />
                  <Button Grid.Column="4"
                          Content="✕"
                          Command="{Binding ForgetSavedAccountCommand}"
                          Classes="aoc-filigree-btn"
                          MinWidth="32"
                          MinHeight="32"
                          Padding="6,4"
                          FontSize="11"
                          ToolTip.Tip="Forget Saved Account"
                          AutomationProperties.Name="Forget Selected Saved Account" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- 2D. Unauthenticated View: Sign In / Create Account & Quick Temp Account -->
            <Border x:Name="SignInPanel"
                    IsVisible="{Binding IsSignedOut}"
                    AutomationProperties.AutomationId="SignInPanel"
                    AutomationProperties.Name="Sign In and Account Registration Panel">
              <StackPanel Spacing="8">

                <!-- Segmented Mode Toggle: SIGN IN vs CREATE ACCOUNT -->
                <Grid ColumnDefinitions="*,8,*">
                  <Button Grid.Column="0"
                          Content="SIGN IN"
                          Command="{Binding SetSignInModeCommand}"
                          Classes="aoc-filigree-btn"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          MinHeight="34"
                          FontSize="11"
                          AutomationProperties.Name="Sign In Mode Tab" />
                  <Button Grid.Column="2"
                          Content="CREATE ACCOUNT"
                          Command="{Binding SetRegisterModeCommand}"
                          Classes="aoc-filigree-btn"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          MinHeight="34"
                          FontSize="11"
                          AutomationProperties.Name="Create Account Mode Tab" />
                </Grid>

                <StackPanel Spacing="3">
                  <TextBlock Text="ACCOUNT USERNAME"
                             FontSize="9.5"
                             FontWeight="Bold"
                             LetterSpacing="1.2"
                             Foreground="{DynamicResource AccentGoldBrush}" />
                  <TextBox x:Name="AuthUsernameInput"
                           Text="{Binding AuthUsername, Mode=TwoWay}"
                           Watermark="Enter Verra account username"
                           Classes="aoc-input"
                           MinHeight="36"
                           AutomationProperties.AutomationId="AuthUsernameInput"
                           AutomationProperties.Name="Account Username Input" />
                </StackPanel>

                <StackPanel Spacing="3" IsVisible="{Binding IsRegisterMode}">
                  <TextBlock Text="EMAIL ADDRESS"
                             FontSize="9.5"
                             FontWeight="Bold"
                             LetterSpacing="1.2"
                             Foreground="{DynamicResource AccentGoldBrush}" />
                  <TextBox x:Name="AuthEmailInput"
                           Text="{Binding AuthEmail, Mode=TwoWay}"
                           Watermark="adventurer@verra.local"
                           Classes="aoc-input"
                           MinHeight="36"
                           AutomationProperties.AutomationId="AuthEmailInput"
                           AutomationProperties.Name="Account Email Input" />
                </StackPanel>

                <StackPanel Spacing="3">
                  <TextBlock Text="PASSWORD"
                             FontSize="9.5"
                             FontWeight="Bold"
                             LetterSpacing="1.2"
                             Foreground="{DynamicResource AccentGoldBrush}" />
                  <TextBox x:Name="AuthPasswordInput"
                           Text="{Binding AuthPassword, Mode=TwoWay}"
                           PasswordChar="•"
                           Watermark="Enter password"
                           Classes="aoc-input"
                           MinHeight="36"
                           AutomationProperties.AutomationId="AuthPasswordInput"
                           AutomationProperties.Name="Account Password Input" />
                </StackPanel>

                <CheckBox Content="Remember Account (Save Credentials)"
                          IsChecked="{Binding RememberCredentials, Mode=TwoWay}"
                          Foreground="{DynamicResource TextMutedBrush}"
                          FontSize="11.5"
                          AutomationProperties.Name="Remember Account Credentials Toggle" />

                <Button x:Name="LoginButton"
                        Content="SIGN IN"
                        Command="{Binding LoginCommand}"
                        IsVisible="{Binding IsSignInMode}"
                        Classes="aoc-jewel-cta"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        MinHeight="40"
                        FontSize="12.5"
                        AutomationProperties.AutomationId="LoginButton"
                        AutomationProperties.Name="Sign In Primary Button" />

                <Button x:Name="RegisterAccountButton"
                        Content="CREATE ACCOUNT"
                        Command="{Binding RegisterAccountCommand}"
                        IsVisible="{Binding IsRegisterMode}"
                        Classes="aoc-jewel-cta"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        MinHeight="40"
                        FontSize="12.5"
                        AutomationProperties.AutomationId="RegisterAccountButton"
                        AutomationProperties.Name="Create Account Primary Button" />

                <Button x:Name="RegisterTempButton"
                        Content="⚡ Quick Temp Account (1-Click Playtest)"
                        Command="{Binding RegisterTempCommand}"
                        Classes="aoc-filigree-btn"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        MinHeight="36"
                        FontSize="11.5"
                        AutomationProperties.AutomationId="RegisterTempButton"
                        AutomationProperties.Name="Quick Temporary Account Button" />
              </StackPanel>
            </Border>

            <!-- 2E. Authenticated View: Active Account Card & Session Controls -->
            <Border x:Name="PostLoginPanel"
                    IsVisible="{Binding IsAuthenticated}"
                    Background="{DynamicResource AoCInputFillBrush}"
                    BorderBrush="{DynamicResource AccentJewelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14,12"
                    AutomationProperties.AutomationId="PostLoginPanel"
                    AutomationProperties.Name="Authenticated Account Card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="SIGNED IN AS"
                               FontSize="9.5"
                               FontWeight="Bold"
                               LetterSpacing="1.4"
                               Foreground="{DynamicResource StatusOnlineBrush}" />
                    <TextBlock x:Name="SignedInUsernameText"
                               Text="{Binding SignedInUsername}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AoCHeadlineTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="SignedInUsernameText"
                               AutomationProperties.Name="Signed In Username" />
                  </StackPanel>

                  <Border Grid.Column="1"
                          x:Name="TempAccountBadge"
                          Background="{DynamicResource SurfacePrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          CornerRadius="3"
                          Padding="8,4"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="TempAccountBadge"
                          AutomationProperties.Name="Account Type Badge">
                    <TextBlock Text="{Binding AccountBadgeText}"
                               FontSize="9.5"
                               FontWeight="Bold"
                               LetterSpacing="1.0"
                               Foreground="{DynamicResource AccentChampagneGoldBrush}" />
                  </Border>
                </Grid>

                <Border Height="1" Background="{DynamicResource AoCGoldDividerBrush}" />

                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0"
                               Text="REALM GATEWAY:"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GatewayHttpAddr}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0"
                               Text="CLIENT BUILD:"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ClientStatusSummary}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusOnlineBrush}"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </StackPanel>

                <Grid ColumnDefinitions="*,8,*">
                  <Button Grid.Column="0"
                          x:Name="LogoutButton"
                          Content="Switch / Sign Out"
                          Command="{Binding LogoutCommand}"
                          Classes="aoc-filigree-btn"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          MinHeight="38"
                          FontSize="11"
                          AutomationProperties.AutomationId="LogoutButton"
                          AutomationProperties.Name="Switch Account or Sign Out Button" />
                  <Button Grid.Column="2"
                          x:Name="DeleteAccountButton"
                          Content="Delete Account"
                          Command="{Binding DeleteAccountCommand}"
                          Classes="aoc-danger-cta"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          MinHeight="38"
                          FontSize="11"
                          AutomationProperties.AutomationId="DeleteAccountButton"
                          AutomationProperties.Name="Delete Account Button" />
                </Grid>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- 3. Bottom of Left 50% Deck: Status Banner, Bioluminescent Readiness Bar & Prominent PLAY CTA -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,10,0,0">
          <Border Height="1" Background="{DynamicResource AoCGoldDividerBrush}" />

          <StackPanel Spacing="4">
            <TextBlock x:Name="StatusBanner"
                       Text="{Binding StatusBannerMessage}"
                       Foreground="{DynamicResource AccentChampagneGoldBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="StatusBanner"
                       AutomationProperties.Name="Status Banner" />
            <ProgressBar Value="100"
                         Minimum="0"
                         Maximum="100"
                         Height="3"
                         Foreground="{DynamicResource StatusOnlineBrush}"
                         Background="{DynamicResource AoCInputFillBrush}"
                         AutomationProperties.Name="Client Readiness Bar" />
          </StackPanel>

          <Button x:Name="PrimaryLaunchCtaButton"
                  Command="{Binding LaunchClientCommand}"
                  IsVisible="{Binding IsGameStopped}"
                  Classes="aoc-jewel-cta"
                  HorizontalAlignment="Stretch"
                  Height="48"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  AutomationProperties.AutomationId="LaunchButton"
                  AutomationProperties.Name="Play Ashes of Creation Primary Action">
            <TextBlock Text="PLAY"
                       FontFamily="Georgia, Times New Roman, serif"
                       FontSize="18"
                       FontWeight="Bold"
                       LetterSpacing="3.5" />
          </Button>

          <Button x:Name="TerminateAshesButton"
                  Command="{Binding TerminateAshesCommand}"
                  IsVisible="{Binding IsAshesProcessRunning}"
                  Classes="aoc-danger-cta"
                  HorizontalAlignment="Stretch"
                  Height="48"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  AutomationProperties.AutomationId="TerminateAshesButton"
                  AutomationProperties.Name="Stop Running Ashes Client Action">
            <TextBlock Text="GAME RUNNING — STOP"
                       FontSize="13"
                       FontWeight="Bold"
                       LetterSpacing="1.2" />
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- LAYER 2: Right 50% Hero Stage (Grid.Column="1") — 100% Unobstructed View of Citadel & Bioluminescent World Tree -->
    <Panel Grid.Column="1" IsHitTestVisible="False" />

  </Grid>
</Window>
