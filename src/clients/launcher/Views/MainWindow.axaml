<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SandalLauncher.ViewModels"
        xmlns:models="using:SandalLauncher.Models"
        xmlns:services="using:SandalLauncher.Services"
        x:Class="SandalLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        MinWidth="960"
        MinHeight="560"
        Width="1067"
        Height="600"
        Title="SandalCore — Ashes of Creation Launcher"
        Background="{DynamicResource SurfacePrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AutomationProperties.Name="SandalCore Ashes of Creation Launcher Window">

  <Grid ColumnDefinitions="5*,5*">

    <!-- LAYER 0: Full-Bleed Random Key Art (launcher_background_0..2.jpg) without Left-Side Darkening Vignette -->
    <Border Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="{DynamicResource AoCHeroFallbackBrush}"
            IsHitTestVisible="False">
      <Image Source="{Binding BackgroundImage}"
             Stretch="UniformToFill" />
    </Border>

    <!-- LAYER 1: Single Unified Semi-Transparent Card (~60% Opacity) in Left 50% with 92%–95% Opacity Controls -->
    <Border Grid.Column="0"
            x:Name="SignInPanel"
            MaxWidth="420"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Margin="36,20,16,20"
            Background="{DynamicResource AoCFiligreeDeckBrush}"
            BorderBrush="{DynamicResource AoCCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="24,20"
            AutomationProperties.AutomationId="SignInPanel"
            AutomationProperties.Name="Launcher Main Control Card">
      <StackPanel Spacing="11">

        <!-- 1. Header: Title + Online Status + Subtle Settings Gear -->
        <Grid ColumnDefinitions="*,Auto,8,Auto">
          <TextBlock Grid.Column="0"
                     Text="SANDALCORE"
                     FontFamily="Georgia, Times New Roman, serif"
                     FontSize="20"
                     FontWeight="Bold"
                     LetterSpacing="3.0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource AoCHeadlineTextBrush}" />

          <TextBlock Grid.Column="1"
                     x:Name="RealmStatusPill"
                     Text="{Binding RealmStatusShortText}"
                     Foreground="{DynamicResource StatusOnlineBrush}"
                     FontWeight="Bold"
                     FontSize="11"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="Server Status Indicator" />

          <Button Grid.Column="3"
                  Content="⚙"
                  Command="{Binding ToggleSettingsCommand}"
                  Classes="aoc-filigree-btn"
                  MinWidth="32"
                  MinHeight="30"
                  Padding="7,4"
                  FontSize="12"
                  ToolTip.Tip="Server &amp; Game Client Path Settings"
                  AutomationProperties.Name="Toggle Settings" />
        </Grid>

        <Border Height="1" Background="{DynamicResource AoCGoldDividerBrush}" />

        <!-- 2. Optional Compact Settings Row (Only Visible When Gear Clicked) -->
        <StackPanel Spacing="8" IsVisible="{Binding IsSettingsOpen}">
          <Grid ColumnDefinitions="*,8,Auto,6,Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding EditGatewayHttpAddr, Mode=TwoWay}"
                     Watermark="127.0.0.1:8080"
                     Classes="aoc-input"
                     MinHeight="34"
                     FontSize="12"
                     AutomationProperties.Name="Gateway Address Input" />
            <Button Grid.Column="2"
                    Content="Client Path..."
                    Command="{Binding OpenClientPathModalCommand}"
                    Classes="aoc-filigree-btn"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    MinHeight="34"
                    Padding="10,4"
                    FontSize="11"
                    AutomationProperties.Name="Open Game Client Path Selector" />
            <Button Grid.Column="4"
                    Content="Save"
                    Command="{Binding SaveProfileCommand}"
                    Classes="aoc-jewel-cta"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    MinHeight="34"
                    Padding="12,4"
                    FontSize="11"
                    AutomationProperties.Name="Save Gateway Settings" />
          </Grid>
        </StackPanel>

        <!-- 3. Server Selector -->
        <StackPanel Spacing="4">
          <TextBlock Text="SERVER"
                     FontSize="9.5"
                     FontWeight="Bold"
                     LetterSpacing="1.3"
                     Foreground="{DynamicResource AccentChampagneGoldBrush}" />
          <ComboBox ItemsSource="{Binding Profiles}"
                    SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    MinHeight="36"
                    AutomationProperties.Name="Server Selector">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:LauncherProfile" x:CompileBindings="True">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0"
                             Text="{Binding DisplayName}"
                             FontWeight="SemiBold"
                             FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding GatewayHttpAddr}"
                             FontSize="11"
                             Foreground="{DynamicResource AccentGoldBrush}"
                             Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- 4. Saved Logins Dropdown (Only Visible When Remembered Accounts Exist) -->
        <StackPanel Spacing="4" IsVisible="{Binding HasSavedAccounts}">
          <TextBlock Text="SAVED LOGIN"
                     FontSize="9.5"
                     FontWeight="Bold"
                     LetterSpacing="1.3"
                     Foreground="{DynamicResource AccentChampagneGoldBrush}" />
          <Grid ColumnDefinitions="*,8,Auto">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding SavedAccounts}"
                      SelectedItem="{Binding SelectedSavedAccount, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MinHeight="36"
                      AutomationProperties.Name="Saved Logins Dropdown">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="services:SavedAccountRecord" x:CompileBindings="True">
                  <TextBlock Text="{Binding DisplayLabel}"
                             FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2"
                    Content="Delete"
                    Command="{Binding ForgetSavedAccountCommand}"
                    Classes="aoc-danger-cta"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    MinHeight="36"
                    Padding="12,4"
                    FontSize="11.5"
                    ToolTip.Tip="Delete saved login"
                    AutomationProperties.Name="Delete Saved Login" />
          </Grid>
        </StackPanel>

        <!-- 5. Username, Email (For Create Account) & Password Inputs -->
        <StackPanel Spacing="4">
          <TextBlock Text="USERNAME"
                     FontSize="9.5"
                     FontWeight="Bold"
                     LetterSpacing="1.3"
                     Foreground="{DynamicResource AccentChampagneGoldBrush}" />
          <TextBox x:Name="AuthUsernameInput"
                   Text="{Binding AuthUsername, Mode=TwoWay}"
                   Watermark="Username"
                   Classes="aoc-input"
                   MinHeight="38"
                   AutomationProperties.AutomationId="AuthUsernameInput"
                   AutomationProperties.Name="Username Input" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsRegisterMode}">
          <TextBlock Text="EMAIL"
                     FontSize="9.5"
                     FontWeight="Bold"
                     LetterSpacing="1.3"
                     Foreground="{DynamicResource AccentChampagneGoldBrush}" />
          <TextBox x:Name="AuthEmailInput"
                   Text="{Binding AuthEmail, Mode=TwoWay}"
                   Watermark="Email address (for new account)"
                   Classes="aoc-input"
                   MinHeight="38"
                   AutomationProperties.AutomationId="AuthEmailInput"
                   AutomationProperties.Name="Email Input" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="PASSWORD"
                     FontSize="9.5"
                     FontWeight="Bold"
                     LetterSpacing="1.3"
                     Foreground="{DynamicResource AccentChampagneGoldBrush}" />
          <TextBox x:Name="AuthPasswordInput"
                   Text="{Binding AuthPassword, Mode=TwoWay}"
                   PasswordChar="•"
                   Watermark="Password"
                   Classes="aoc-input"
                   MinHeight="38"
                   AutomationProperties.AutomationId="AuthPasswordInput"
                   AutomationProperties.Name="Password Input" />
        </StackPanel>

        <CheckBox Content="Remember login"
                  IsChecked="{Binding RememberCredentials, Mode=TwoWay}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  FontSize="12"
                  Margin="0,-2,0,0"
                  AutomationProperties.Name="Remember Login Checkbox" />

        <!-- 6. Unified Action Buttons Directly Below Username & Password -->
        <StackPanel Spacing="8" Margin="0,2,0,0">

          <!-- Primary PLAY Button (Signs In + Launches Game Client) -->
          <Button x:Name="LoginButton"
                  Command="{Binding PlayGameCommand}"
                  IsVisible="{Binding IsGameStopped}"
                  Classes="aoc-jewel-cta"
                  HorizontalAlignment="Stretch"
                  Height="46"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  AutomationProperties.AutomationId="LoginButton"
                  AutomationProperties.Name="Sign In and Play Ashes of Creation">
            <TextBlock Text="PLAY"
                       FontFamily="Georgia, Times New Roman, serif"
                       FontSize="17"
                       FontWeight="Bold"
                       LetterSpacing="3.5" />
          </Button>

          <!-- STOP GAME Button (Visible When Client Is Running) -->
          <Button x:Name="TerminateAshesButton"
                  Command="{Binding TerminateAshesCommand}"
                  IsVisible="{Binding IsAshesProcessRunning}"
                  Classes="aoc-danger-cta"
                  HorizontalAlignment="Stretch"
                  Height="46"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  AutomationProperties.AutomationId="TerminateAshesButton"
                  AutomationProperties.Name="Stop Running Game">
            <TextBlock Text="STOP GAME"
                       FontSize="14"
                       FontWeight="Bold"
                       LetterSpacing="2.0" />
          </Button>

          <!-- Create Account & Temp Account Directly Below PLAY -->
          <Grid ColumnDefinitions="*,10,*">
            <Button Grid.Column="0"
                    x:Name="RegisterAccountButton"
                    Content="Create Account"
                    Command="{Binding RegisterAccountCommand}"
                    Classes="aoc-filigree-btn"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Height="38"
                    FontSize="12"
                    AutomationProperties.AutomationId="RegisterAccountButton"
                    AutomationProperties.Name="Create Account and Play" />

            <Button Grid.Column="2"
                    x:Name="RegisterTempButton"
                    Content="Temp Account"
                    Command="{Binding RegisterTempCommand}"
                    Classes="aoc-filigree-btn"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Height="38"
                    FontSize="12"
                    AutomationProperties.AutomationId="RegisterTempButton"
                    AutomationProperties.Name="Create Ephemeral Temp Account and Play" />
          </Grid>

          <!-- Sign Out Button (Visible When Signed In; Immediately Deletes Account if Temp) -->
          <Button x:Name="LogoutButton"
                  Content="{Binding SignOutButtonLabel}"
                  Command="{Binding LogoutCommand}"
                  IsVisible="{Binding IsAuthenticated}"
                  Classes="aoc-filigree-btn"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Height="34"
                  FontSize="11.5"
                  AutomationProperties.AutomationId="LogoutButton"
                  AutomationProperties.Name="Sign Out of Current Session" />
        </StackPanel>

        <!-- 7. Compact Status Line -->
        <TextBlock x:Name="StatusBanner"
                   Text="{Binding StatusBannerMessage}"
                   Foreground="{DynamicResource AccentChampagneGoldBrush}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,2,0,0"
                   AutomationProperties.AutomationId="StatusBanner"
                   AutomationProperties.Name="Launcher Status Message" />

      </StackPanel>
    </Border>

    <!-- LAYER 2: Right 50% Hero Stage (100% Unobstructed Key Art) -->
    <Panel Grid.Column="1" IsHitTestVisible="False" />

    <!-- LAYER 3: Multi-Version / Unknown Steam Path Modal Popup -->
    <Border Grid.Column="0"
            Grid.ColumnSpan="2"
            IsVisible="{Binding IsClientPathModalOpen}"
            Background="{DynamicResource AoCModalBackdropBrush}">
      <Border MaxWidth="520"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="24"
              Background="{DynamicResource AoCModalCardBrush}"
              BorderBrush="{DynamicResource AccentJewelBorderBrush}"
              BorderThickness="1.5"
              CornerRadius="8"
              Padding="24,20"
              AutomationProperties.Name="Select Game Client Version Modal">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding ClientPathModalTitle}"
                     FontFamily="Georgia, Times New Roman, serif"
                     FontSize="16"
                     FontWeight="Bold"
                     LetterSpacing="2.0"
                     Foreground="{DynamicResource AoCHeadlineTextBrush}" />

          <TextBlock Text="{Binding ClientPathModalSubtitle}"
                     FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap" />

          <StackPanel Spacing="5" IsVisible="{Binding HasDiscoveredClientInstalls}">
            <TextBlock Text="DETECTED STEAM INSTALLATIONS"
                       FontSize="9.5"
                       FontWeight="Bold"
                       LetterSpacing="1.3"
                       Foreground="{DynamicResource AccentChampagneGoldBrush}" />
            <ComboBox ItemsSource="{Binding DiscoveredClientInstalls}"
                      SelectedItem="{Binding SelectedDiscoveredInstall, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MinHeight="38"
                      AutomationProperties.Name="Detected Steam Installations Dropdown">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="services:DiscoveredClientInstall" x:CompileBindings="True">
                  <TextBlock Text="{Binding DisplayLabel}"
                             FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="GAME CLIENT FOLDER OR EXECUTABLE PATH"
                       FontSize="9.5"
                       FontWeight="Bold"
                       LetterSpacing="1.3"
                       Foreground="{DynamicResource AccentChampagneGoldBrush}" />
            <TextBox Text="{Binding EditClientPakDir, Mode=TwoWay}"
                     Watermark="Paste path to Ashes of Creation folder or AOCClient-Win64-Shipping.exe"
                     Classes="aoc-input"
                     MinHeight="38"
                     FontSize="12"
                     AutomationProperties.Name="Custom Game Client Path Input" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,10,Auto" Margin="0,4,0,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding ClientStatusSummary}"
                       FontSize="11"
                       Foreground="{DynamicResource StatusOnlineBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    Content="Cancel"
                    Command="{Binding CloseClientPathModalCommand}"
                    Classes="aoc-filigree-btn"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    MinHeight="36"
                    Padding="14,6"
                    FontSize="12"
                    AutomationProperties.Name="Cancel Client Path Selection" />
            <Button Grid.Column="3"
                    Content="Confirm &amp; Save"
                    Command="{Binding ConfirmClientPathCommand}"
                    Classes="aoc-jewel-cta"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    MinHeight="36"
                    Padding="16,6"
                    FontSize="12"
                    AutomationProperties.Name="Confirm and Save Game Client Path" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</Window>
