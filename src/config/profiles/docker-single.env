# Single-node Docker Compose profile ([::] binds & Compose service DNS advertise)
AOC_ENV=development
SANDAL_ADVERTISE_HOST=127.0.0.1
AOC_MESH_MODE=standalone
AOC_DATABASE_URL=postgres://aoc:aoc@postgres:5432/aoc?sslmode=disable
AOC_GATEWAY_HTTP_BIND_ADDR=[::]:8080
AOC_GATEWAY_HTTP_ADVERTISE_ADDR=gatewayd:8080
AOC_GATEWAY_ICS_BIND_ADDR=[::]:8444
AOC_GATEWAY_ICS_ADVERTISE_ADDR=gatewayd:8444
AOC_GATEWAY_GRPC_BIND_ADDR=[::]:50050
AOC_GATEWAY_GRPC_ADVERTISE_ADDR=gatewayd:50050
AOC_ADMIN_HTTP_BIND_ADDR=[::]:8090
AOC_ADMIN_HTTP_ADVERTISE_ADDR=admind:8090
AOC_ADMIN_HTTPS_BIND_ADDR=[::]:8443
AOC_ADMIN_HTTPS_ADVERTISE_ADDR=admind:8443
AOC_ADMIN_METRICS_BIND_ADDR=[::]:9099
AOC_ADMIN_METRICS_ADVERTISE_ADDR=admind:9099
AOC_TETHER_UDP_BIND_ADDR=[::]:19021
AOC_TETHER_UDP_ADVERTISE_ADDR=tetherd:19021
AOC_MESHGW_UDP_BIND_ADDR=[::]:19022
AOC_MESHGW_UDP_ADVERTISE_ADDR=meshgwd:19022
AOC_AUTH_HTTP_BIND_ADDR=[::]:8081
AOC_AUTH_HTTP_ADVERTISE_ADDR=authd:8081
AOC_AUTH_GRPC_BIND_ADDR=[::]:50051
AOC_AUTH_GRPC_ADVERTISE_ADDR=authd:50051
AOC_CHARACTER_GRPC_BIND_ADDR=[::]:50052
AOC_CHARACTER_GRPC_ADVERTISE_ADDR=characterd:50052
AOC_DIRECTOR_GRPC_BIND_ADDR=[::]:50053
AOC_DIRECTOR_GRPC_ADVERTISE_ADDR=directord:50053
AOC_MESH_GRPC_BIND_ADDR=[::]:50054
AOC_MESH_GRPC_ADVERTISE_ADDR=meshd:50054
AOC_CITYNODE_GRPC_BIND_ADDR=[::]:50055
AOC_CITYNODE_GRPC_ADVERTISE_ADDR=citynoded:50055
AOC_QUEST_GRPC_BIND_ADDR=[::]:50058
AOC_QUEST_GRPC_ADVERTISE_ADDR=questd:50058
AOC_WORLD_UDP_PORT=7777
AOC_WORLD_UDP_BIND_ADDR=[::]:7777
AOC_WORLD_UDP_ADVERTISE_ADDR=worldd:7777
AOC_WORLD_ADMIN_BIND_ADDR=[::]:50056
AOC_GM_STARTER_SET=true
