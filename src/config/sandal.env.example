# 1. Core Runtime, Logging & Client Paths (#1-#9)
AOC_ENV=development
SANDAL_CONFIG_FILE=config/sandal.env
SANDAL_ADVERTISE_HOST=ingress-proxy
SANDAL_LOG_LEVEL=INFO
SANDAL_LOG_FORMAT=json
SANDAL_CLIENT_PAK_DIR=C:\Program Files\Intrepid Studios\Ashes of Creation\AOC\Content\Paks
SANDAL_CLIENT_EXE_PATH=AOC\Binaries\Win64\AoCClient-Win64-Shipping.exe
SANDAL_CLIENT_USE_EOS=false
SANDAL_USMAP_PATH=data/mappings/<mappings>.usmap
# 2. Extraction, Backing Storage, Navmesh & Security Tokens (#10-#27)
AOC_SKIP_EXTRACTION=0
AOC_EXTRACTOR_THREADS=0
AOC_EXTRACTED_DIR=dist/extracted
AOC_MESH_MODE=standalone
AOC_DATABASE_URL=postgres://aoc:aoc@postgres:5432/aoc?sslmode=disable
AOC_POSTGRES_HOST_PORT=5433
AOC_DB_MAX_CONNS=16
AOC_DB_MIN_CONNS=2
# Optional pgxpool connection lifecycle bounds:
# AOC_DB_MAX_CONN_LIFETIME=30m
# AOC_DB_MAX_CONN_IDLE_TIME=5m
AOC_SQL_MIGRATIONS_DIR=services/sql/migrations
AOC_CONTENT_DB_PATH=dist/content/content.db
AOC_HOTFIX_DIR=config/hotfixes
AOC_PMTILES_PATH=dist/content/verra.pmtiles
AOC_NAVMESH_DIR=dist/nav
AOC_RIVERLANDS_NAVMESH_PATH=dist/nav/riverlands.aocnav
AOC_VMAP_PATH=dist/nav/area_vmap.bin
AOC_SERVICE_TOKEN_FILE=dist/services/service.token
AOC_TOKEN_TTL=24h
AOC_TICKET_TTL=2m
# 3. Edge Gateway, Admin BFF & Mesh Gateway Bind/Advertise (#28-#45)
AOC_GATEWAY_HTTP_BIND_ADDR=[::]:8081
AOC_GATEWAY_HTTP_ADVERTISE_ADDR=gateway:8081
AOC_GATEWAY_ICS_BIND_ADDR=[::]:50061
AOC_GATEWAY_ICS_ADVERTISE_ADDR=gateway:50061
AOC_GATEWAY_GRPC_BIND_ADDR=[::]:50050
AOC_GATEWAY_GRPC_ADVERTISE_ADDR=gateway:50050
AOC_GATEWAY_TLS_CERT=/app/certs/server.pem
AOC_GATEWAY_TLS_KEY=/app/certs/server.key
AOC_TLS_CA_CERT=dist/certs/ca.pem
AOC_ADMIN_HTTP_BIND_ADDR=[::]:8088
AOC_ADMIN_HTTP_ADVERTISE_ADDR=web-admin:8088
AOC_ADMIN_HTTPS_BIND_ADDR=[::]:8443
AOC_ADMIN_HTTPS_ADVERTISE_ADDR=web-admin:8443
AOC_ADMIN_METRICS_BIND_ADDR=[::]:9099
AOC_ADMIN_METRICS_ADVERTISE_ADDR=web-admin:9099
AOC_TETHER_UDP_PORT=19021
AOC_MESH_GATEWAY_UDP_BIND_ADDR=[::]:8082
AOC_MESH_GATEWAY_UDP_ADVERTISE_ADDR=mesh-gateway:8082
# 4. Internal Control-Plane gRPC & HTTP Services (#46-#62)
AOC_AUTH_HTTP_BIND_ADDR=[::]:8081
AOC_AUTH_HTTP_ADVERTISE_ADDR=auth:8081
AOC_AUTH_GRPC_BIND_ADDR=[::]:50052
AOC_AUTH_GRPC_ADVERTISE_ADDR=auth:50052
AOC_CHARACTER_GRPC_BIND_ADDR=[::]:50053
AOC_CHARACTER_GRPC_ADVERTISE_ADDR=character:50053
AOC_DIRECTOR_GRPC_BIND_ADDR=[::]:50054
AOC_DIRECTOR_GRPC_ADVERTISE_ADDR=mesh:50054
AOC_MESH_GRPC_BIND_ADDR=[::]:50054
AOC_MESH_GRPC_ADVERTISE_ADDR=mesh:50054
AOC_MESH_HEARTBEAT_TTL=15s
AOC_MESH_STATIC_WORLD=
AOC_CITYNODE_GRPC_BIND_ADDR=[::]:50056
AOC_CITYNODE_GRPC_ADVERTISE_ADDR=citynode:50056
AOC_CITYNODE_SEED=config/seeds/citynode_seed.json
AOC_QUEST_GRPC_BIND_ADDR=[::]:50057
AOC_QUEST_GRPC_ADVERTISE_ADDR=quest:50057
# 5. Realm & Authoritative World Simulation (#63-#72)
AOC_REALM_ID=verra-dev
AOC_REALM_NAME=Verra Development
AOC_WORLD_SERVER_ID=world-0
AOC_WORLD_UDP_PORT=7777
AOC_WORLD_UDP_BIND_ADDR=[::]:7777
AOC_WORLD_UDP_ADVERTISE_ADDR=world:7777
AOC_WORLD_ADMIN_BIND_ADDR=[::]:50061
AOC_WORLD_TICK_RATE_HZ=30
AOC_GM_STARTER_SET=true
# 6. Docker Compose, Envoy Ingress & Container Port/Endpoint Defaults
POSTGRES_USER=aoc
POSTGRES_PASSWORD=CHANGE_ME
 AOC_SERVICE_TOKEN=CHANGE_ME
 AOC_JWT_SECRET=CHANGE_ME
POSTGRES_DB=aoc
POSTGRES_PORT=5432
INGRESS_HTTP_PORT=8080
INGRESS_GRPC_PORT=9090
ENVOY_HTTP_INGRESS_PORT=8080
ENVOY_GRPC_INGRESS_PORT=9090
ENVOY_ADMIN_PORT=9901
GATEWAY_HTTP_PORT=8081
GATEWAY_GRPC_PORT=50050
MESH_GATEWAY_HTTP_PORT=8082
AUTH_GRPC_PORT=50052
CHARACTER_GRPC_PORT=50053
MESH_GRPC_PORT=50054
CITYNODE_GRPC_PORT=50056
QUEST_GRPC_PORT=50057
WEB_ADMIN_PORT=8088
WEB_PORT=8088
WORLD_UDP_PORT=7777
WORLD_ADMIN_PORT=50061
WORLD_PUBLIC_HOST=127.0.0.1
WORLD_HOST=127.0.0.1
WORLD_PORT=7777
AOC_AREA_RADIUS_M=-1
AUTH_GRPC_ADDR=auth:50052
CHAR_GRPC_ADDR=character:50053
CITYNODE_GRPC_ADDR=citynode:50056
QUEST_GRPC_ADDR=quest:50057
MESH_GRPC_ADDR=mesh:50054
WORLD_ADMIN_GRPC_ADDR=world:50061

# ─── World Server In-Memory File Caching & Per-Tick Entity Budgets ────────────
# Preload content.db (~314 MB) and area_nav.bin (~1.0 GB) into RAM at startup
# so runtime spatial streaming and database queries never block on disk I/O.
 AOC_WORLD_CACHE_ALL_CONTENT_IN_MEMORY=true
 AOC_WORLD_CACHE_CONTENT_DB_IN_MEMORY=true
 AOC_WORLD_CACHE_AREA_NAV_IN_MEMORY=true
 AOC_WORLD_CACHE_FILES=content.db,area_nav.bin

# Per-tick (30 Hz / 33.33 ms) spatial streaming & entity processing budgets:
 AOC_WORLD_NAV_PUMP_BUDGET_MS=4.0
 AOC_WORLD_NPC_GROUND_PER_TICK=32
 AOC_WORLD_NPC_GROUND_BUDGET_MS=2.0
 AOC_WORLD_NPC_STATS_PER_TICK=24
 AOC_WORLD_NPC_PATHFINDS_PER_STEP=24
 AOC_WORLD_ACTOR_OPEN_PER_TICK=24
 AOC_WORLD_ACTOR_WAKE_PER_TICK=24
 AOC_WORLD_ACTOR_UPDATE_PER_TICK=64
 AOC_WORLD_NODE_SUMMARIES_PER_TICK=4
 AOC_WORLD_FOLIAGE_CELLS_PER_TICK=2

# Optional host overrides for TLS certificates and Unreal mappings (.usmap):
# If unset, SandalCore checks $HOME/.aoc/certs and $HOME/.aoc/usmap/aoc.usmap automatically.
# SANDAL_CERTS_OVERRIDE_DIR=
# SANDAL_TLS_CERT_PATH=
# SANDAL_TLS_KEY_PATH=
# SANDAL_USMAP_OVERRIDE_DIR=
# SANDAL_USMAP_PATH=
# AOC_USMAP=

