# SPDX-License-Identifier: AGPL-3.0-only
# Context-isolation manifest for OCI multi-stage builds (OPS-01, OPS-02, SEC-01).

# Version control, issue DAG, knowledge graph & agent harness metadata
.git
.git/
.gitignore
.gitattributes
.github
.github/
.beads
.beads/
.dolt/
graphify-out
graphify-out/
.graphifyignore
.agents
.agents/
_workspace
_workspace/
.vscode/
.vs/
.idea/
.clangd/

# Build trees, caches & intermediate artifacts
build
build/
build/x64/
build/dotnet/
build/venv/
build*/
cmake-build-*/
out
out/
dist/
bin/
obj/
target/
vcpkg_installed/
node_modules
node_modules/
**/node_modules/
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Explicitly allow generated code, third-party build inputs, content & source tree
!build/gen/
!build/gen/**
!build/third_party/
!build/third_party/**
!dist/content/
!dist/content/**
!src/
!src/**

# Ignore desktop control-app & internal notes inside source/docs
src/tools/control-app/
docs/
docs/notes/
tests/fixtures/
*.md

# Game data archives, runtime state & debug symbols
data
data/
third_party/CUE4Parse/
*.pdb
*.ipdb
*.iobj
*.ilk
*.pch
*.pak
*.utoc
*.ucas
*.aocnav
*.pmtiles
!dist/content/*.pmtiles
*.db
!dist/content/*.db
*.db-*
*.sqlite3
*.log
*.jsonl
capture_*.bin
dump_*.bin

# Secrets, local environment overrides & private keys (SEC-01)
.env
.env*
*.env
*.secret
*.token
*.pem
*.key
*.pfx
certs/*.key
certs/*.pem
certs/*.crt
config/certs/*.key
config/*.local.json
config/local.json
