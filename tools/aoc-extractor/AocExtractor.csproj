<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(NETCoreSdkVersion)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">net10.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AocExtractor</RootNamespace>
    <AssemblyName>aoc-extractor</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8765;CS8767;CS0108;CS0114;CS0168;CS0169;CS0219;CS0649;CS0414;CS0659;CS0660;CS0661;CS8981;CS1591;CS0618;SYSLIB0011;SYSLIB0021;CS8631;CS8632;CS0067;CS8509;CS8524;CS8073;CA1857;CA2022;IDE0059</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <CUE4Src>$(MSBuildThisFileDirectory)..\..\build\third_party\CUE4Parse\CUE4Parse\</CUE4Src>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
    <Compile Include="$(CUE4Src)**\*.cs" Exclude="$(CUE4Src)obj\**;$(CUE4Src)bin\**" />
    <EmbeddedResource Include="$(CUE4Src)Resources\ACE7Key.bin" LogicalName="CUE4Parse.Resources.ACE7Key.bin" />
    <EmbeddedResource Include="$(CUE4Src)Resources\PUBGNameHashMap.json" LogicalName="CUE4Parse.Resources.PUBGNameHashMap.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Blake3" Version="2.0.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="FixedMathSharp" Version="1.3.3" />
    <PackageReference Include="Fmod5Sharp" Version="3.0.1" />
    <PackageReference Include="GenericReader" Version="2.3.0" />
    <PackageReference Include="Infrablack.UE4Config" Version="0.7.2.97" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.20" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OffiUtils" Version="3.0.0" />
    <PackageReference Include="Oodle.NET" Version="2.2.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="VGAudio" Version="2.2.1" />
    <PackageReference Include="Zlib-ng.NET" Version="1.2.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>
</Project>
